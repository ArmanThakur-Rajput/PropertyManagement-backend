# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hyperrealestate

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=30d

# ── Cloudflare R2 (replaces Cloudinary) ───────────────────────────────────────
# Get these from: Cloudflare Dashboard → R2 → Your Bucket → API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=hyper-realestate

# R2 Public URL — set this AFTER enabling "Public Access" on your bucket
# Format 1 (default R2 subdomain): https://pub-xxxxxxxxxxxxxxxx.r2.dev
# Format 2 (custom domain):        https://media.yourwebsite.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ── Email (optional) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=HyperRelestix <no-reply@yoursite.com>

# ── AI Chat (optional) ────────────────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key
